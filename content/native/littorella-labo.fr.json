  "messages": {
    "greeting": "Sorbier : Une pierre a réagi.\nTon rapport parle de migrations.\rVeux-tu poursuivre l’enquête\nou étudier ton Pokédex ?",
    "investigate": "Enquête",
    "pokedex": "Pokédex",
    "later": "Plus tard",
    "intro_east": "Les oiseaux quittent le lac.\nUne Méga-Gemme y a vibré.\rAvant de relier ces événements,\ncherchons un second indice.",
    "intro_west": "Les oiseaux reviennent au lac.\nUne Méga-Gemme y a vibré.\rRefuge ou simple coïncidence ?\nCherchons un second indice.",
    "analyst_task": "Analyste, consulte le PC\nau fond à droite du laboratoire.\rCompare les heures du relevé\net rapporte ce qu’il démontre.",
    "scout_task": "Éclaireur, interroge l’éleveur\nau sud du laboratoire, près\rde la maison de mon assistant.\nDemande un fait précis.",
    "readings": "PC : Relevé de Bonaugure.\n5 h 50 : grondement, pierre active.\r6 h : premier groupe d’Étourmi.\nQue permet ce relevé ?",
    "careful": "Comparer les heures",
    "accuse": "Désigner un coupable",
    "wrong": "Une heure ne désigne personne.\nDistingue le fait mesuré\rde ce que tu supposes.\nTu peux reprendre le relevé.",
    "evidence": "Le signal précède le vol.\nSa cause reste à vérifier.\rRetourne voir Sorbier\npour confronter cet indice.",
    "analyst_report": "Sorbier : Le signal des pierres\nprécède le déplacement.\rTu as distingué ce fait mesuré\nd’une explication encore inconnue.",
    "scout_report": "Sorbier : Le témoin a entendu\nle bruit avant le vol des oiseaux.\rLe capteur situe aussi à cette heure\nla réaction d’une Méga-Gemme.",
    "conclusion_east": "Ils ont pu fuir cette résonance.\nUne autre région a-t-elle observé\rle même phénomène ? Comparons\nles faits avant de conclure.",
    "conclusion_west": "Ils ont pu suivre cette résonance.\nUne autre région a-t-elle observé\rle même phénomène ? Comparons\nles faits avant de conclure.",
    "reward": "Voici tes trois Poké Balls.\nEn route pour Féli-Cité.\rCherche si des pierres y réagissent.\nCe phénomène dépasse le lac.",
    "bag_full": "Ton Sac manque de place.\nReviens chercher tes trois\rPoké Balls après l’avoir rangé.\nTon rapport reste enregistré.",
    "done_east": "Rapport classé : départ du lac\naprès la réaction d’une pierre.\rTa prochaine étape : Féli-Cité.\nObserve les signes de résonance.",
    "done_west": "Rapport classé : retour au lac\naprès la réaction d’une pierre.\rTa prochaine étape : Féli-Cité.\nObserve les signes de résonance."
  },
