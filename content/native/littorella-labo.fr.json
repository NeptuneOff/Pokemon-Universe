  "messages": {
    "greeting": "Sorbier : Le rapport est arrivé.\nVeux-tu poursuivre l’enquête\rou parler de ton Pokédex ?",
    "investigate": "Enquête",
    "pokedex": "Pokédex",
    "later": "Plus tard",
    "intro_east": "Les Étourmi quittent le lac.\nAvant de parler de danger,\ril nous faut un second indice,\nindépendant de ce trajet.",
    "intro_west": "Les Étourmi reviennent au lac.\nUn refuge ? C’est une hypothèse.\rIl nous faut un second indice\navant de tirer une conclusion.",
    "analyst_task": "Analyste, consulte le PC\nau fond à droite du laboratoire.\rCompare les heures du relevé\net rapporte ce qu’il démontre.",
    "scout_task": "Éclaireur, interroge l’éleveur\nau sud du laboratoire, près\rde la maison de mon assistant.\nDemande un fait précis.",
    "readings": "PC : Relevé de Bonaugure.\n5 h 50 : grondement lointain.\r6 h : premier groupe d’Étourmi.\nQue permet ce relevé ?",
    "careful": "Comparer les heures",
    "accuse": "Désigner un coupable",
    "wrong": "Une heure ne désigne personne.\nDistingue le fait mesuré\rde ce que tu supposes.\nTu peux reprendre le relevé.",
    "evidence": "Le grondement précède le vol.\nSa cause reste à vérifier.\rRetourne voir Sorbier\npour confronter cet indice.",
    "analyst_report": "Sorbier : Tu as bien distingué\nl’observation de l’explication.\rLe bruit précède le mouvement.\nCela nous donne une piste.",
    "scout_report": "Sorbier : Ton témoin situe\nle grondement avant les oiseaux.\rCe souvenir mérite un contrôle,\nmais nous avons enfin une piste.",
    "conclusion_east": "Ils ont pu fuir le grondement.\nNous comparerons les relevés\rd’autres lieux avant d’accuser\nqui que ce soit.",
    "conclusion_west": "Ils ont pu chercher un refuge.\nNous comparerons les relevés\rd’autres lieux avant d’accuser\nqui que ce soit.",
    "reward": "Tu reçois trois Poké Balls.\nContinue ton voyage à Féli-Cité.\rObserve les Pokémon en chemin :\nchaque découverte compte.",
    "bag_full": "Ton Sac manque de place.\nReviens chercher tes trois\rPoké Balls après l’avoir rangé.\nTon rapport reste enregistré.",
    "done_east": "Rapport classé : départ du lac,\naprès un grondement lointain.\rTa prochaine étape : Féli-Cité.\nPoursuis tes observations.",
    "done_west": "Rapport classé : retour au lac,\naprès un grondement lointain.\rTa prochaine étape : Féli-Cité.\nPoursuis tes observations."
  },
